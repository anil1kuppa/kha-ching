# Docker Compose profile — controls whether local postgres/redis containers start.
# Set to "local" to spin them up (default), or remove/leave empty to use external URLs.
COMPOSE_PROFILES=local

# PostgreSQL Database Configuration
# Preferred: use a single connection string
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/trading_db

# Optional fallback if not using DATABASE_URL / DB_URL
DB_HOST=localhost
DB_PORT=5432
DB_NAME=trading_db
DB_USER=postgres
DB_PASSWORD=postgres

# Redis Configuration
REDIS_URL=redis://127.0.0.1:6379
PRODUCTION_REDS_URL=redis://your_production_redis_url_here

# Kite API Configuration
KITE_API_KEY=your_kite_api_key
KITE_API_SECRET=your_kite_api_secret
URL=http://localhost:3000/api/redirect_url_kite
ProductionURL=https://your_production_url/api/redirect_url_kite

# Next.js Configuration
NODE_ENV=development
PORT=3000
TZ=Asia/Kolkata
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_DEFAULT_LOTS=2
NEXT_PUBLIC_DEFAULT_SKEW_PERCENT=10
NEXT_PUBLIC_DEFAULT_SQUARE_OFF_TIME=15:20
NEXT_PUBLIC_DEFAULT_SLM_PERCENT=30

# Session / Security
SECRET_COOKIE_PASSWORD=your_secure_cookie_password_min_32_chars

# Mock Configuration (development)
MOCK_ORDERS=true

# Grafana Cloud OTEL (logs via OpenTelemetry Collector)
OTEL_EXPORTER_OTLP_ENDPOINT=https://otlp-gateway-prod-ap-south-1.grafana.net/otlp
OTEL_EXPORTER_OTLP_HEADERS=Authorization=Basic%20<your_base64_token_here>
